{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CNKI",
  "version": "1.0.4",
  "identifier": "com.cnki.citation",
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CNKI 引文工具",
        "width": 820,
        "height": 700,
        "minWidth": 680,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
